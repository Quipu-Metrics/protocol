{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quipumetrics.org/schema/v1/submission.schema.json",
  "title": "Quipu Metrics submission",
  "description": "Request body for POST /v1/data/{platform}, before gzip compression.",
  "type": "object",
  "required": [
    "serverUUID",
    "playerAmount",
    "onlineMode",
    "platformVersion",
    "osName",
    "osArch",
    "osVersion",
    "coreCount",
    "service"
  ],
  "additionalProperties": false,
  "properties": {
    "serverUUID": {
      "type": "string",
      "description": "Random version 4 UUID identifying the host, shared by every service on it.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "playerAmount": {
      "type": "integer",
      "description": "Players online at collection time. -1 when unknown.",
      "minimum": -1,
      "maximum": 1000000
    },
    "onlineMode": {
      "type": "integer",
      "description": "1 online mode, 0 offline mode, -1 unknown.",
      "enum": [-1, 0, 1]
    },
    "platformVersion": {
      "type": "string",
      "description": "Raw version string as reported by the platform. Never pre-parsed.",
      "minLength": 1,
      "maxLength": 256
    },
    "javaVersion": {
      "type": "string",
      "description": "Omitted by non-JVM clients.",
      "maxLength": 64
    },
    "osName": { "type": "string", "minLength": 1, "maxLength": 64 },
    "osArch": { "type": "string", "minLength": 1, "maxLength": 32 },
    "osVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "coreCount": {
      "type": "integer",
      "description": "Logical cores available to the process.",
      "minimum": 1,
      "maximum": 4096
    },
    "service": { "$ref": "#/$defs/service" }
  },
  "$defs": {
    "service": {
      "type": "object",
      "required": ["id", "version", "charts"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "description": "Service id issued by quipumetrics.org.",
          "minimum": 1
        },
        "version": {
          "type": "string",
          "description": "Version of the plugin or mod.",
          "minLength": 1,
          "maxLength": 64
        },
        "charts": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/chart" }
        }
      }
    },
    "chart": {
      "type": "object",
      "required": ["chartId", "data"],
      "additionalProperties": false,
      "properties": {
        "chartId": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,64}$"
        },
        "data": {
          "description": "Shape depends on the chart type configured server side. See SPEC.md section 7.1.",
          "oneOf": [
            { "$ref": "#/$defs/singleValueNumber" },
            { "$ref": "#/$defs/singleValueString" },
            { "$ref": "#/$defs/flatValues" },
            { "$ref": "#/$defs/nestedValues" },
            { "$ref": "#/$defs/arrayValues" }
          ]
        }
      }
    },
    "singleValueNumber": {
      "description": "single_line",
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "integer" }
      }
    },
    "singleValueString": {
      "description": "simple_pie",
      "type": "object",
      "required": ["value"],
      "additionalProperties": false,
      "properties": {
        "value": { "$ref": "#/$defs/label" }
      }
    },
    "flatValues": {
      "description": "advanced_pie, simple_bar, multi_line",
      "type": "object",
      "required": ["values"],
      "additionalProperties": false,
      "properties": {
        "values": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": { "$ref": "#/$defs/label" },
          "additionalProperties": { "type": "integer" }
        }
      }
    },
    "nestedValues": {
      "description": "drilldown_pie",
      "type": "object",
      "required": ["values"],
      "additionalProperties": false,
      "properties": {
        "values": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": { "$ref": "#/$defs/label" },
          "additionalProperties": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 64,
            "propertyNames": { "$ref": "#/$defs/label" },
            "additionalProperties": { "type": "integer" }
          }
        }
      }
    },
    "arrayValues": {
      "description": "advanced_bar",
      "type": "object",
      "required": ["values"],
      "additionalProperties": false,
      "properties": {
        "values": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": { "$ref": "#/$defs/label" },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": { "type": "integer" }
          }
        }
      }
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
